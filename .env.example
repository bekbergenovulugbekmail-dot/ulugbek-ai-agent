# ---------------------------------------------------------------------------
# ULUGBEK AI — environment variables
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Ulugbek AI"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false               # true -> structured JSON logs (recommended in prod)

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["*"]

# --- Database ---
# Local docker-compose default. Railway injects DATABASE_URL automatically;
# a postgres:// or postgresql:// URL is upgraded to postgresql+asyncpg:// at runtime.
#
# Use 127.0.0.1, not localhost: on Windows "localhost" resolves to ::1 first,
# while Docker Desktop publishes the port on IPv4 — the connection is accepted
# and then reset, which surfaces as a confusing SSL-handshake error.
DATABASE_URL=postgresql+asyncpg://ulugbek:ulugbek@127.0.0.1:5432/ulugbek_ai
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
# Only for a key that spans several workspaces: such a key runs in the workspace
# each request names, and without this the API rejects the call with a 400.
# A key scoped to a single workspace needs nothing here.
# Find the ID in the Console under Settings > Workspaces (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=high           # low | medium | high | xhigh | max
CLAUDE_THINKING=true
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=2

# --- Agent loop ---
AGENT_MAX_ITERATIONS=8
AGENT_MAX_REPLANS=2
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_VERIFICATION_ENABLED=true

# --- Tool execution ---
TOOL_DEFAULT_TIMEOUT_SECONDS=30
TOOL_MAX_RESULT_CHARS=8000

# --- Memory ---
MEMORY_CONTEXT_LIMIT=20
MEMORY_CONTEXT_MAX_CHARS=12000

# --- Permissions -------------------------------------------------------------
# One of: auto | approval | deny  (per permission level).
# CRITICAL is always forced to `approval` regardless of what is set here.
PERMISSION_READ=auto
PERMISSION_WRITE=auto
PERMISSION_EXECUTE=approval
PERMISSION_DELETE=approval
PERMISSION_CRITICAL=approval

# --- GitHub integration -------------------------------------------------------
# A fine-grained personal access token. Give it the least it needs:
#   read-only:  Contents: Read, Metadata: Read, Actions: Read, Pull requests: Read
#   to open issues, add: Issues: Read and write
# Leave empty to work with public repositories only (heavily rate limited).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20

# --- Local docker-compose only ----------------------------------------------
# Host port for the bundled PostgreSQL. Change it if something else already
# listens on 5432, and keep DATABASE_URL in step with it.
POSTGRES_PORT=5432
