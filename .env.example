# ---------------------------------------------------------------------------
# ULUGBEK AI — environment variables
# Copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Ulugbek AI"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false               # true -> structured JSON logs (recommended in prod)

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=["*"]

# --- Authentication -----------------------------------------------------------
# The operator's token. Required: without it every protected route answers 503
# and names this variable, rather than serving anyone who asks. Only /api/health
# stays open, so a platform can still check whether the service is alive.
#
# It is a shared secret between the server and the one operator, not a user
# account and not an API key: ANTHROPIC_API_KEY authenticates this server to
# Anthropic and must never be reused here.
#
# Generate one (at least 32 characters) and never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN=

# How long a stream token stays valid. EventSource cannot send headers, so the
# console exchanges the operator token for a short-lived signed one that rides
# in the query string; this bounds what a leaked URL is worth.
AUTH_STREAM_TOKEN_TTL_SECONDS=300

# --- Database ---
# Local docker-compose default. Railway injects DATABASE_URL automatically;
# a postgres:// or postgresql:// URL is upgraded to postgresql+asyncpg:// at runtime.
#
# Use 127.0.0.1, not localhost: on Windows "localhost" resolves to ::1 first,
# while Docker Desktop publishes the port on IPv4 — the connection is accepted
# and then reset, which surfaces as a confusing SSL-handshake error.
DATABASE_URL=postgresql+asyncpg://ulugbek:ulugbek@127.0.0.1:5432/ulugbek_ai
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
# Only for a key that spans several workspaces: such a key runs in the workspace
# each request names, and without this the API rejects the call with a 400.
# A key scoped to a single workspace needs nothing here.
# Find the ID in the Console under Settings > Workspaces (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TOKENS=16000
CLAUDE_EFFORT=high           # low | medium | high | xhigh | max
CLAUDE_THINKING=true
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=2

# --- Speech: voice in, voice out ---------------------------------------------
# The operator speaks, the console transcribes, and the transcript goes into
# the command box for review — never straight to the agent.
#
# The key is read here and nowhere else. The browser talks to this service, and
# this service talks to the provider: every NEXT_PUBLIC_* value is compiled
# into the bundle and is therefore public, so a key can never live there.
#
# Google Cloud Speech-to-Text, with an API key restricted to the Speech-to-Text
# API. Leave STT_API_KEY empty and the microphone is simply absent; nothing
# else changes.
# rubai: this project's own speech service (services/rubai-stt) running
# whisper.cpp with an Uzbek fine-tune. No cloud key, no per-minute cost, and
# the audio never leaves the deployment.
STT_PROVIDER=rubai           # rubai | google | disabled

# Where that service listens. On Railway use the private address so the model
# is never exposed to the internet: http://rubai-stt.railway.internal:8080
STT_SERVICE_URL=
# Shared with the speech service, which refuses to start without it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
STT_SERVICE_TOKEN=

# Google Cloud, kept as an alternative provider. Unused when STT_PROVIDER=rubai.
STT_API_KEY=
STT_API_URL=https://speech.googleapis.com/v1/speech:recognize
STT_LANGUAGE=uz-UZ
# The enforced limit. A larger body is refused before a provider is called.
STT_MAX_BYTES=10485760
# What the recorder respects, and what a declared duration is checked against.
STT_MAX_SECONDS=60
STT_TIMEOUT_SECONDS=60

# `browser` means the console reads answers aloud with the browser's own
# SpeechSynthesis: no key, no cost, no audio leaving the machine. A server-side
# voice would be a second adapter behind the TextToSpeech interface.
TTS_PROVIDER=browser         # browser | disabled

# --- Agent loop ---
AGENT_MAX_ITERATIONS=12
AGENT_MAX_REPLANS=2
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_VERIFICATION_ENABLED=true

# --- Tool execution ---
TOOL_DEFAULT_TIMEOUT_SECONDS=30
TOOL_MAX_RESULT_CHARS=8000

# --- Memory ---
MEMORY_CONTEXT_LIMIT=20
MEMORY_CONTEXT_MAX_CHARS=12000

# --- Permissions -------------------------------------------------------------
# One of: auto | approval | deny  (per permission level).
# CRITICAL is always forced to `approval` regardless of what is set here.
PERMISSION_READ=auto
PERMISSION_WRITE=auto
PERMISSION_EXECUTE=approval
PERMISSION_DELETE=approval
PERMISSION_CRITICAL=approval

# --- GitHub integration -------------------------------------------------------
# A fine-grained personal access token. Give it the least it needs:
#   read-only:  Contents: Read, Metadata: Read, Actions: Read, Pull requests: Read
#   to open issues, add: Issues: Read and write
# Leave empty to work with public repositories only (heavily rate limited).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20

# --- Railway integration ------------------------------------------------------
# Deploying is a CRITICAL action: it always asks for approval in the browser,
# whatever PERMISSION_CRITICAL says.
#
# Account token   Railway dashboard -> Account Settings -> Tokens  (kind: account)
# Project token   Project Settings -> Tokens                       (kind: project)
# The two use different headers, so the kind has to match the token.
RAILWAY_TOKEN=
RAILWAY_TOKEN_KIND=account
RAILWAY_API_URL=https://backboard.railway.com/graphql/v2
RAILWAY_TIMEOUT_SECONDS=30

# Default target, so a command does not have to repeat ids. The project id is
# in the dashboard URL: railway.com/project/<RAILWAY_PROJECT_ID>. Ask the agent
# for railway_project_info to get the service and environment ids.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=

# How long a deploy waits for Railway to finish before reporting. Past this it
# reports the deployment as still running — never as a success.
RAILWAY_DEPLOY_WAIT_SECONDS=90

# --- Local docker-compose only ----------------------------------------------
# Host port for the bundled PostgreSQL. Change it if something else already
# listens on 5432, and keep DATABASE_URL in step with it.
POSTGRES_PORT=5432
