# Base URL of the ULUGBEK AI backend API.
#
# This is a PUBLIC value — it is embedded in the browser bundle.
# Never put an API key, a token or any secret in a NEXT_PUBLIC_* variable.
#
# It is also a BUILD-TIME value: Next inlines every NEXT_PUBLIC_* variable when
# the bundle is compiled, so setting it on a running container does nothing.
# In a Docker build it must be passed as a build argument; on Railway, set it
# as a service variable, which is available to the build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
